{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/tools/verityflow", "destination": "https://verityflow.vercel.app/tools/verityflow" },
    { "source": "/tools/verityflow/:path*", "destination": "https://verityflow.vercel.app/tools/verityflow/:path*" }
  ],
  "headers": [
    {
      "source": "/infographics/(.*)-embed",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/infographics/(.*)-embed.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    }
  ]
}
